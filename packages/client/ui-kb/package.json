{
  "name": "@matter/client-ui-kb",
  "description": "Minimal knowledge-base page for Matter's client: doc list + detail rendering a body through the blocks.editor.surface slot (first real consumer of ui-blocks, zero package imports).",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/types/client/index.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/types/**/*.d.ts", "lib/types/client/*.js", "src"],
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@matter/document": "workspace:*",
    "@matter/document-controller": "workspace:*",
    "@matter/client-ui-blocks": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.2"
  }
}
