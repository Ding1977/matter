{
  "name": "@matter/client-ui-blocks",
  "description": "BlockNote-backed block editor core for Matter's client: headless editor boot, an explicit props/marks mapping layer between @matter/blocks records and BlockNote blocks, and A-tier(9)/Marks(8) round-trip conversion. Data/mapping only; no default UI chrome and no visual surface in P3.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/types/client/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/client/*.js",
    "src"
  ],
  "dependencies": {
    "@blocknote/core": "0.57.0",
    "@blocknote/react": "0.57.0",
    "@matter/blocks": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.2"
  }
}
